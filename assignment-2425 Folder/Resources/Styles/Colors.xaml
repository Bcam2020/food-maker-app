<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Existing Colors -->
    <Color x:Key="Primary">#FFA500</Color>
    <Color x:Key="PrimaryDark">#</Color>

    <Color x:Key="BackgroundColor">#FFCC00</Color>
    <Color x:Key="BackgroundColorDark">#121212</Color>

    <Color x:Key="TextColor">#000000</Color>
    <Color x:Key="TextColorDark">#FFFFFF</Color>

    <Color x:Key="Gray200">#E0E0E0</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray950">#1A1A1A</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Toolbar Colors -->
    <Color x:Key="ToolbarColorLight">#FFA500</Color>
    <Color x:Key="ToolbarColorDark">#FFCC00</Color>
    <Color x:Key="ToolbarTextColorLight">White</Color>
    <Color x:Key="ToolbarTextColorDark">LightGray</Color>
</ResourceDictionary>
