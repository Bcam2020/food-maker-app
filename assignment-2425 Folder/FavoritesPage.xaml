<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="assignment_2425.FavoritesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:assignment_2425.Controls"
             Title="Favorites"
             Background="{DynamicResource AppBackgroundColor}"
             Shell.NavBarIsVisible="False"
             SemanticProperties.Description="Favorites page displaying your favorite recipes.">
    <AbsoluteLayout>
        <!-- Top navigation bar -->
        <controls:StadiumTopBar
            Title="Favorites"
            AbsoluteLayout.LayoutBounds="0,0,1,40"
            AbsoluteLayout.LayoutFlags="WidthProportional,PositionProportional"
            SemanticProperties.Description="Top navigation bar for favorites" />
        <!-- Main content scroll view -->
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All"
                    Margin="0,40,0,90"
                    SemanticProperties.Description="Scroll view for favorite recipes list">
            <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center">
                <Label Text="My Favorite Recipes"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AppTextColor}"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="Page title: My Favorite Recipes" />
                <CollectionView x:Name="FavoriteRecipesCollectionView"
                                ItemsSource="{Binding FavoriteRecipes}"
                                SelectionMode="None"
                                HeightRequest="300"
                                SemanticProperties.Description="List of favorite recipes">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView SemanticProperties.Description="Favorite recipe card">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="Red"
                                                   Invoked="OnDeleteFavoriteInvoked"
                                                   CommandParameter="{Binding .}"
                                                   SemanticProperties.Description="Delete favorite button" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Frame Grid.Column="0"
                                           Padding="10"
                                           Margin="5"
                                           BackgroundColor="{DynamicResource AppBackgroundColor}"
                                           BorderColor="#DADADA"
                                           CornerRadius="12"
                                           HasShadow="True"
                                           SemanticProperties.Description="Recipe details">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteTapped"
                                                                  CommandParameter="{Binding .}"
                                                                  SemanticProperties.Description="Tap to view recipe details" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   TextColor="{DynamicResource AppTextColor}"
                                                   SemanticProperties.Description="Recipe name" />
                                        </VerticalStackLayout>
                                    </Frame>
                                    <BoxView Grid.Column="1"
                                             WidthRequest="6"
                                             HorizontalOptions="End"
                                             VerticalOptions="FillAndExpand"
                                             Margin="0,5,5,5"
                                             Color="#DADADA"
                                             Opacity="0.6"
                                             SemanticProperties.Description="Separator" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <!-- Bottom navigation bar -->
        <controls:StadiumBottomBar
            AbsoluteLayout.LayoutBounds="0.5,1,1,90"
            AbsoluteLayout.LayoutFlags="WidthProportional,PositionProportional"
            SemanticProperties.Description="Bottom navigation bar" />
    </AbsoluteLayout>
</ContentPage>
