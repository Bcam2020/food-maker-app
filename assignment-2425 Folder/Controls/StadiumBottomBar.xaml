<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="assignment_2425.Controls.StadiumBottomBar"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             SemanticProperties.Description="Bottom navigation bar">
    <Frame x:Name="StadiumFrame"
         Padding="0"
         CornerRadius="45"
         BackgroundColor="#FFA500"
         HeightRequest="90"
         HasShadow="True"
         VerticalOptions="End"
         HorizontalOptions="FillAndExpand">
        <Grid VerticalOptions="Center"
          HorizontalOptions="FillAndExpand"
          ColumnDefinitions="*,*,*,*,*"
          Padding="20,0">
            <ImageButton Grid.Column="0"
                   Source="home.png"
                   Clicked="OnHomeClicked"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HeightRequest="32"
                   SemanticProperties.Description="Home button"
                   SemanticProperties.Hint="Double tap to go home" />
            <ImageButton Grid.Column="1"
                   Source="add.png"
                   Clicked="OnAddRecipeClicked"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HeightRequest="32"
                   SemanticProperties.Description="Add Recipe button"
                   SemanticProperties.Hint="Double tap to add a recipe" />
            <ImageButton Grid.Column="2"
                   Source="group_users.png"
                   Clicked="OnCommunityClicked"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HeightRequest="32"
                   SemanticProperties.Description="Community button"
                   SemanticProperties.Hint="Double tap to view community" />
            <ImageButton Grid.Column="3"
                   Source="profile_user.png"
                   Clicked="OnProfileClicked"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HeightRequest="32"
                   SemanticProperties.Description="Profile button"
                   SemanticProperties.Hint="Double tap to view profile" />
            <ImageButton Grid.Column="4"
                   Source="food.png"
                   Clicked="OnFavoritesClicked"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HeightRequest="32"
                   SemanticProperties.Description="Favorites button"
                   SemanticProperties.Hint="Double tap to view favorites" />
        </Grid>
    </Frame>
</ContentView>
