<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="assignment_2425.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:assignment_2425.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="AppBackgroundColor">#F8F8F8</Color>
            <Color x:Key="AppTextColor">#333333</Color>
            <x:Double x:Key="GlobalFontSize">16</x:Double>
            <converters:ZeroToFalseConverter x:Key="ZeroToFalseConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
