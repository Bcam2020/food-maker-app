<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="assignment_2425.SearchUsersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Search Users">
    <!-- Hide default back button -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>
    <!-- Custom back button in toolbar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Clicked="OnBackClicked" Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>
    <VerticalStackLayout Padding="20" Spacing="10">
        <!-- Search bar for users -->
        <SearchBar x:Name="UserSearchBar"
                   Placeholder="Search by username or email"
                   SearchButtonPressed="OnSearchBarButtonPressed"
                   TextChanged="OnSearchBarTextChanged" />
        <!-- List of users -->
        <CollectionView x:Name="UsersCollectionView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="8" HasShadow="True">
                        <Grid>
                            <!-- Display username or email -->
                            <Label Text="{Binding UsernameOrEmail}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold"
                                   FontSize="18" />
                            <!-- Button to add friend -->
                            <Button Text="Add Friend"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Clicked="OnAddFriendClicked"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
